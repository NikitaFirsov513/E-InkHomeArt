# Overlay after sdkconfig.defaults; UART-based display/touch assembly test.
CONFIG_APP_DISPLAY_TOUCH_TEST=y
# Standard S3 CPU frequency; optimize software without changing panel waveforms.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_DISPLAY_TOUCH_PARTIAL_TEST=y
CONFIG_DISPLAY_TOUCH_SPI_MHZ=8
CONFIG_DISPLAY_TOUCH_TARGET_MS=350
# Experimental drawing profile; vendor recommendation is 5. See DISPLAY_TOUCH_TEST.md.
CONFIG_DISPLAY_TOUCH_PARTIALS_BEFORE_CLEAN=30
# CONFIG_APP_LED_TEST is not set
# CONFIG_SPIRAM is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Conservative full-only interval, used when the interactive partial bench is off.
CONFIG_DIAG_MIN_REFRESH_SECONDS=180
