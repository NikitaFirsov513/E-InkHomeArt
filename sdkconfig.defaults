# E-InkHomeArt: ESP32-S3-WROOM-1U-N16R8
CONFIG_IDF_TARGET="esp32s3"

# N16: 16 MiB Quad SPI flash (not Octal flash).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# First assembly check: only the D6 LED, internal RAM, no PSRAM initialization.
# CONFIG_APP_DISPLAY_TOUCH_TEST is not set
CONFIG_APP_LED_TEST=y
# CONFIG_SPIRAM is not set

# UART0 on GPIO43/44 works without the board's USB connector.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
